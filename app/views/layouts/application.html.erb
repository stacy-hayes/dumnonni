<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "Dumnonni Chronicles" %></title>

  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta
    name="description"
    content="Dumnonni Chronicles is a live action roleplay group inspired by Celtic mythology, dark age Britain, and heroic storytelling."
  >

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="page-body">
<a href="#main-content" class="skip-link">
  Skip to content
</a>

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-logo-link" aria-label="Dumnonni Chronicles home">
      <%= image_tag "DC_LOGO_MASTER.svg",
                    alt: "Dumnonni Chronicles",
                    class: "site-logo" %>
    </a>

    <nav aria-label="Primary navigation" class="desktop-nav">
      <ul class="desktop-nav-list">
        <li><a href="/about" class="nav-link">About</a></li>
        <li><a href="/rules" class="nav-link">Rules</a></li>
        <li><a href="/booking" class="nav-link">Booking</a></li>
        <li><a href="/gallery" class="nav-link">Gallery</a></li>
        <li><a href="/contact" class="nav-link">Contact</a></li>
      </ul>
    </nav>

    <details class="mobile-nav-details">
      <summary class="mobile-nav-summary" aria-label="Open navigation menu">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="mobile-menu-icon"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5m-16.5 5.25h16.5m-16.5 5.25h16.5" />
        </svg>
      </summary>

      <nav aria-label="Mobile navigation" class="mobile-menu">
        <ul class="mobile-nav-list">
          <li><a href="/" class="mobile-nav-link">Home</a></li>
          <li><a href="/about" class="mobile-nav-link">About</a></li>
          <li><a href="/rules" class="mobile-nav-link">Rules</a></li>
          <li><a href="/booking" class="mobile-nav-link">Booking</a></li>
          <li><a href="/gallery" class="mobile-nav-link">Gallery</a></li>
          <li><a href="/contact" class="mobile-nav-link">Contact</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<main id="main-content" class="site-main">
  <%= yield %>
</main>

<footer class="site-footer">
  <div class="site-footer-inner">
    <section>
      <h2 class="footer-heading">
        Dumnonni Chronicles
      </h2>

      <p class="footer-description">
        Live action roleplay inspired by Celtic mythology, dark age Britain,
        and heroic storytelling.
      </p>
    </section>

    <section>
      <h2 class="footer-heading">
        Community
      </h2>

      <ul class="footer-list">
        <li>
          <a
            href="https://www.facebook.com/dumnonni"
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook
          </a>
        </li>

        <li>
          <a
            href="https://discord.gg/VPaFrcg6uf"
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Discord
          </a>
        </li>
      </ul>
    </section>

    <section>
      <h2 class="footer-heading">
        Find us
      </h2>

      <ul class="footer-list">
        <li>
          <a
            href="https://maps.app.goo.gl/mTT6yJwWq8bZPWNL6"
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Google Maps
          </a>
        </li>

        <li>
          <h3 class="footer-text">What3Words</h3>
          <p class="footer-text">voted.leotard.canoe</p>
        </li>
      </ul>
    </section>
  </div>

  <div class="footer-bottom">
    © <%= Time.current.year %> Dumnonni Chronicles. All rights reserved.
  </div>
</footer>
</body>
</html>