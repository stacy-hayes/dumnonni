<section class="py-16">
  <div class="max-w-6xl mx-auto px-6">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% element.ingredient(:images).pictures.each do |picture| %>

        <div>
          <%= render_picture picture,
                             class: "w-full h-auto rounded-xl" %>
        </div>

      <% end %>
    </div>

  </div>
</section>