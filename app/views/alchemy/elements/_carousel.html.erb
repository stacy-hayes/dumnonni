<%= element_view_for(element) do |el| %>
  <% slides = element.nested_elements %>

  <% if slides.any? %>
    <section class="content-carousel-section" aria-label="Featured pages">
      <div class="content-carousel" data-controller="carousel">
        <% if slides.size > 5 %>
          <button
            class="content-carousel-arrow content-carousel-arrow-left"
            type="button"
            aria-label="Previous carousel items"
            data-action="carousel#previous"
          >
            ‹
          </button>
        <% end %>

        <div class="content-carousel-viewport">
          <div class="content-carousel-track" data-carousel-target="track">
            <%= render partial: "alchemy/elements/carousel_slide",
                       collection: slides,
                       as: :element %>
          </div>
        </div>

        <% if slides.size > 5 %>
          <button
            class="content-carousel-arrow content-carousel-arrow-right"
            type="button"
            aria-label="Next carousel items"
            data-action="carousel#next"
          >
            ›
          </button>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>