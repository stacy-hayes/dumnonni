<section class="py-20 bg-black text-white text-center">
  <div class="max-w-4xl mx-auto px-6">

    <h2 class="text-4xl font-bold mb-8">
      <%= element.value_for(:headline) %>
    </h2>

    <a
      href="<%= element.value_for(:button_link) %>"
      class="inline-block bg-white text-black px-6 py-3 rounded-lg"
    >
      <%= element.value_for(:button_text) %>
    </a>

  </div>
</section>