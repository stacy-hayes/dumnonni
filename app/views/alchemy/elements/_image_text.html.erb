<section class="py-16">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">

    <div>
      <%= render_picture element.value_for(:image) %>
    </div>

    <div>
      <h2 class="text-3xl font-bold mb-4">
        <%= element.value_for(:headline) %>
      </h2>

      <div class="prose prose-lg">
        <%= element.value_for(:body) %>
      </div>
    </div>

  </div>
</section>