<%= element_view_for(element) do |el| %>
  <div class="carousel-item <%= 'active' if carousel_slide_counter.zero? %>">
    <%= el.render :image, { size: "1200x500" }, class: "d-block w-100" %>

    <% if el.ingredient(:title).present? || el.ingredient(:caption).present? %>
      <div class="carousel-caption d-none d-md-block">
        <h5><%= el.ingredient(:title) %></h5>
        <p><%= el.ingredient(:caption) %></p>
      </div>
    <% end %>
  </div>
<% end %>
